# Copy to .env (git-ignored) and fill in only what you need. Never commit real values.

# --- Meta Model API (Muse Spark) -------------------------------------------
# Used by the local explain API (api/wattdocket_api), the optional explain
# handler (api/lambda_explain) and the permit reader
# (scripts/read_permit_with_muse.py).
META_API_KEY=your-meta-model-api-key
META_API_BASE=https://api.meta.ai/v1
WATTDOCKET_EXPLAIN_MODEL=muse-spark-1.3
# Set to 1 to skip model calls and always use the deterministic template.
MODEL_OFF=0

# --- Optional data source ---------------------------------------------------
# EPA CAMD API key, only for scripts/calibrate_camd.py and scripts/camd_probe.py.
CAMD_API_KEY=your-camd-api-key

# --- Web app (Vite) ---------------------------------------------------------
# Leave these unset for local development against the bundled static snapshot.
# VITE_API_BASE=
# VITE_EXPLAIN_URL=http://127.0.0.1:8787/explain
# Optional: point the operator view at your own OIDC provider. No provider is
# configured by default, and the repository ships no accounts or credentials.
# VITE_COGNITO_ISSUER=https://issuer.example
# VITE_COGNITO_CLIENT_ID=your-public-client-id
# VITE_COGNITO_DOMAIN=https://auth.example
