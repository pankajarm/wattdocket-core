{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wattdocket.dev/schemas/card.schema.json",
  "title": "WattDocket facility card",
  "description": "The contract between the Python engine and the TypeScript UI. Frozen deliberately: three lanes meet on this file, not on a conversation. Every claim carries a badge, an as-of date and a renderable flag; a value that is not published is a discriminated union member, never null and never zero.",
  "type": "object",
  "required": ["schema_version", "facility", "grid", "claims", "as_of", "generated_by"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "generated_by": { "type": "string", "examples": ["wattdocket.cards@0.1.0"] },
    "as_of": { "type": "string", "description": "ISO 8601 UTC" },
    "facility": {
      "type": "object",
      "required": ["id", "name", "lat", "lon", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "operator": { "type": ["string", "null"] },
        "address": { "type": ["string", "null"] },
        "city": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"] },
        "zip": { "type": ["string", "null"] },
        "lat": { "type": "number" },
        "lon": { "type": "number" },
        "naics": { "type": ["string", "null"] },
        "status": {
          "enum": ["operating", "under_construction", "expanding", "proposed",
                   "permitted", "closed", "unknown"],
          "description": "'unknown' is honest and required when the source row does not carry a status"
        },
        "class_label": {
          "type": "string",
          "description": "What the source actually says about the facility type, e.g. 'Listed under NAICS 518210 (computing infrastructure)'"
        },
        "class_verified": {
          "type": "boolean",
          "description": "false when the facility type rests on a NAICS code alone and no site evidence has been checked"
        },
        "class_evidence": { "type": "string" }
      }
    },
    "grid": {
      "type": "object",
      "required": ["subregion", "subregion_name", "rate_lb_per_mwh",
                   "intensity_state", "factor_set_id", "binding_method"],
      "additionalProperties": false,
      "properties": {
        "subregion": { "type": "string", "examples": ["SRVC"] },
        "subregion_name": { "type": "string" },
        "utility": { "type": ["string", "null"] },
        "balancing_authority": { "type": ["string", "null"] },
        "rate_lb_per_mwh": { "type": "number", "minimum": 0 },
        "intensity_state": { "enum": ["PROVISIONAL", "SETTLED"] },
        "factor_set_id": { "type": "string" },
        "factor_set_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "binding_method": { "enum": ["point_in_polygon", "operator_filing", "manual", "none"] }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sentence": { "type": "string", "maxLength": 240 },
        "source": { "enum": ["model", "template"] },
        "degraded": { "type": "boolean" }
      }
    },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "hourly": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "ba": { "type": "string" },
        "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "intervals": { "type": "integer" },
        "means_lb_per_mwh": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 24, "maxItems": 24
        },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "ratio": { "type": "number" }
      }
    }
  },
  "$defs": {
    "not_published": {
      "type": "object",
      "required": ["state", "reason"],
      "additionalProperties": false,
      "properties": {
        "state": { "enum": ["NOT_PUBLISHED", "NOT_REPORTED", "BELOW_THRESHOLD"] },
        "reason": { "type": "string" }
      },
      "description": "A first-class answer. Must never be rendered as 0 or blank."
    },
    "citation": {
      "type": "object",
      "required": ["doc_sha256", "page", "line", "quote", "verified"],
      "additionalProperties": false,
      "properties": {
        "doc_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "page": { "type": "integer", "minimum": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "quote": { "type": "string", "minLength": 8 },
        "publisher": { "type": "string" },
        "dataset": { "type": "string" },
        "field": { "type": "string" },
        "verified": { "type": "boolean" },
        "verifier_version": { "type": "string" }
      }
    },
    "claim": {
      "type": "object",
      "required": ["id", "metric", "unit", "badge", "as_of", "renderable"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "metric": {
          "enum": ["power_mw", "carbon_t", "water_gal", "diesel_mw",
                   "diesel_hours", "land_acres", "ghg_scope1"]
        },
        "unit": { "type": "string" },
        "value": {
          "oneOf": [
            { "type": "number" },
            { "$ref": "#/$defs/not_published" }
          ],
          "description": "number OR the not-published union member — never null"
        },
        "badge": { "enum": ["MEASURED", "REPORTED", "MODELED", "ESTIMATED"] },
        "provisional": { "type": "boolean" },
        "as_of": { "type": "string" },
        "range": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "p10": { "type": "number" },
            "p50": { "type": "number" },
            "p90": { "type": "number" }
          }
        },
        "drivers": { "type": "array", "items": { "type": "string" } },
        "citations": { "type": "array", "items": { "$ref": "#/$defs/citation" } },
        "calc_id": { "type": ["string", "null"] },
        "chain": { "type": "array", "items": { "type": "string" } },
        "transforms": { "type": "array", "items": { "type": "string" } },
        "sensitivity": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "delta": { "type": "string" }
            }
          }
        },
        "renderable": { "type": "boolean" },
        "render_block_reason": { "type": "string" }
      }
    }
  }
}
